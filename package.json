{
  "name": "@vehicles-dev/sdk",
  "version": "0.1.1",
  "description": "Official server-side TypeScript SDK for the vehicles.dev API.",
  "keywords": [
    "vehicles",
    "vin",
    "automotive",
    "vehicle-data",
    "sdk"
  ],
  "homepage": "https://vehicles.dev/docs",
  "bugs": {
    "url": "https://github.com/vehicles-dev/typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vehicles-dev/typescript-sdk.git"
  },
  "license": "MIT",
  "author": "Vehicles.dev",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "smoke:git-install": "node ./scripts/smoke-git-install.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
